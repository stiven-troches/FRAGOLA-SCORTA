{
  "name": "scorta",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/node-junit.xml",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=80 --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"browser-*/**\" --test-coverage-exclude=\"node_modules/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/node-junit.xml --test-reporter=lcov --test-reporter-destination=test-results/lcov.info",
    "test:ui": "playwright test",
    "build:demo": "vite build --mode demo && node scripts/finalize-demo.mjs",
    "preview:demo": "vite preview --outDir dist-demo --host 127.0.0.1 --port 4173",
    "test:demo:ui": "playwright test --config playwright.demo.config.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "papaparse": "5.7.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@playwright/test": "1.65.1",
    "fake-indexeddb": "6.2.8",
    "vite": "8.3.8"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
