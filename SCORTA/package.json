{
  "name": "motoshop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test",
    "test:ui": "npm run build && playwright test",
    "build:demo": "vite build --mode demo && node scripts/finalize-demo.mjs",
    "preview:demo": "vite preview --outDir dist-demo --host 127.0.0.1 --port 4173",
    "test:demo:ui": "npm run build:demo && playwright test --config playwright.demo.config.mjs"
  },
  "dependencies": {
    "papaparse": "^5.5.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "fake-indexeddb": "^6.2.8",
    "vite": "8.3.7"
  }
}
