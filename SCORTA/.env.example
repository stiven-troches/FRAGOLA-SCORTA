# Copia este archivo a .env (nunca lo subas a git). Con Docker Compose (compose.yaml) solo llegan a la app
# las variables que compose.yaml lista; con Render se definen en el panel y este archivo es solo la guía.
# Si un valor lleva el símbolo $, enciérralo entre comillas simples ('...') o Compose lo interpreta.

# Solo Docker Compose: dominio público (Caddy obtiene el certificado) y base de SCORTA_PUBLIC_URL.
DOMAIN=inventario.tudominio.com

# --- Propietario de la plataforma ---
# SOLO se leen en el primer arranque, cuando no existe platform.sqlite. Defínelas TÚ: el servidor no
# exige empresa/usuario/nombre, pero si quedan vacías usa los nombres de ejemplo "Fragola" y "Steven"
# (credencial por defecto predecible: no las dejes vacías en un servidor nuevo).
# Al restaurar una plataforma existente (docs/SALIDA-DE-RENDER.md) déjalas todas vacías.
SCORTA_OWNER_COMPANY=
SCORTA_OWNER_USER=
SCORTA_OWNER_NAME=
# También recibe las alertas por correo (capacidad, respaldo, errores 5xx, seguridad).
SCORTA_OWNER_EMAIL=
# OBLIGATORIA en el primer arranque (8+ caracteres con número, mayúscula, minúscula y símbolo; con
# NODE_ENV=production sin base y sin ella el servidor no arranca). Cuando ya existe platform.sqlite no se usa:
# bórrala (el servidor avisa en el log: "borra SCORTA_OWNER_PASSWORD de Render; ya no se usa").
SCORTA_OWNER_PASSWORD=
SCORTA_OWNER_CONTACT=
# URL pública canónica (obligatoria en producción: enlaces de correo y control de origen).
# Render: https://<servicio>.onrender.com. Docker Compose la arma sola con DOMAIN (no la pongas).
SCORTA_PUBLIC_URL=
# Render: HOST=0.0.0.0, NODE_ENV=production, SCORTA_PUBLIC_URL=https://<servicio>.onrender.com
# DATA_DIR = ruta del Persistent Disk (p. ej. /var/data). Los respaldos de arranque quedan en DATA_DIR/backups (se conservan 5).

# --- IP real del cliente (límites de intentos de ingreso) ---
# Vacía = usar la IP del socket. No la definas si el servidor se expone sin proxy.
# Docker Compose + Caddy: si la dejas vacía, compose.yaml usa x-forwarded-for (con 1 salto), que es lo correcto.
# Recomendado en Render detrás de Cloudflare: cf-connecting-ip (un solo valor puesto por Cloudflare).
# Con x-forwarded-for se usa la entrada número SCORTA_TRUSTED_PROXY_HOPS contando desde la DERECHA
# (1 = la última, la que añadió el proxy de confianza); la primera la puede falsificar el cliente.
# Cómo comprobarlo: pon SCORTA_LOG_IP_HEADERS=1, entra a la app y busca en el log de Render las líneas
# "event":"ip-headers". Usa la cabecera cuyo valor coincide con tu IP pública (p. ej. la que muestra
# https://ifconfig.me). Si cf-connecting-ip no llega, usa x-forwarded-for y ajusta los saltos para que
# coincida. Después quita SCORTA_LOG_IP_HEADERS.
SCORTA_CLIENT_IP_HEADER=
SCORTA_TRUSTED_PROXY_HOPS=1
SCORTA_LOG_IP_HEADERS=

# --- Operación ---
# Cuántas respuestas 5xx en 5 minutos disparan la alerta por correo "Ráfaga de errores" (por defecto 10).
SCORTA_ALERT_5XX_THRESHOLD=
# 1 = arranca sin abrir las bases (para restaurar desde Render Shell); /api responde 503 y /healthz responde 200 con "maintenance":true.
SCORTA_MAINTENANCE=
# Versión mostrada en /healthz si no existe RENDER_GIT_COMMIT (Render la define sola).
SCORTA_VERSION=
# 1 = exige aceptar los términos (siempre activo con NODE_ENV=production).
SCORTA_REQUIRE_TERMS=
# 2FA obligatoria para el propietario (siempre activa con NODE_ENV=production; 0 = opcional, 1 = exigir también en desarrollo).
SCORTA_REQUIRE_OWNER_2FA=

# --- Respaldo externo cifrado (se activa solo si están todas las variables obligatorias) ---
# En producción (NODE_ENV=production) sin las variables obligatorias el servidor arranca, pero registra un error,
# /healthz marca warning:true y llega la alerta por correo "offsite-backup-disabled".
# Opt-out explícito (solo si de verdad no quieres respaldo externo): SCORTA_OFFSITE_BACKUP=off
SCORTA_OFFSITE_BACKUP=
# Llave: base64 de 32 bytes (recomendado; genera con
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# o una frase larga (se deriva con scrypt y sal aleatoria por archivo). Guárdala FUERA de Render también:
# sin ella los respaldos no se pueden descifrar. Descifrar: node platform-backup.mjs decrypt archivo.enc salida.sqlite
# Imágenes en disco (sin SCORTA_MEDIA_S3_*): node platform-backup.mjs decrypt-media carpeta-media-descargada DATA_DIR/media
SCORTA_BACKUP_KEY=
SCORTA_BACKUP_INTERVAL_MIN=60
# Cloudflare R2: https://<cuenta>.r2.cloudflarestorage.com (región auto). B2/AWS: su endpoint S3 y región.
# Usa una llave con permiso solo de escritura en el bucket. La retención (p. ej. 30 días) se configura
# con reglas de ciclo de vida del bucket; activa versionado o bloqueo de objetos si el proveedor lo permite.
SCORTA_S3_ENDPOINT=
SCORTA_S3_BUCKET=
SCORTA_S3_REGION=auto
SCORTA_S3_ACCESS_KEY_ID=
SCORTA_S3_SECRET_ACCESS_KEY=
SCORTA_S3_PREFIX=scorta
# Healthchecks.io (o similar): GET <url> tras cada respaldo correcto y <url>/fail si falla.
SCORTA_BACKUP_PING_URL=

# --- Fotos de productos y logos (BE-30) ---
# Con las 4 variables obligatorias las imágenes van a R2 (recomendado en producción); si falta alguna,
# se guardan en DATA_DIR/media y el respaldo externo de arriba las sube cifradas cada hora.
# Usa un bucket distinto al de respaldos, SIN regla de borrado por antigüedad, y un token de R2 con
# lectura y escritura solo en ese bucket. Las imágenes siempre se sirven por la app (/media/...).
SCORTA_MEDIA_S3_ENDPOINT=
SCORTA_MEDIA_S3_BUCKET=
SCORTA_MEDIA_S3_REGION=auto
SCORTA_MEDIA_S3_ACCESS_KEY_ID=
SCORTA_MEDIA_S3_SECRET_ACCESS_KEY=
SCORTA_MEDIA_S3_PREFIX=

# --- Correo: recuperación de contraseña y verificación (SEG-13) ---
# Sin estas variables la recuperación por correo queda apagada: la pantalla de ingreso pide
# al usuario que su administrador restablezca la contraseña y no se envía ningún correo.
# Requiere además SCORTA_PUBLIC_URL (los enlaces se arman solo con esa URL).
# Opción 1 (recomendada): Resend. Verifica tu dominio en resend.com y crea una llave de "envío".
RESEND_API_KEY=
SCORTA_MAIL_FROM="SCORTA <no-responder@tudominio.com>"
# Opción 2: webhook HTTPS propio que recibe POST JSON {from,to,subject,text}.
# El secreto (opcional) llega como "Authorization: Bearer <secreto>".
SCORTA_MAIL_WEBHOOK_URL=
SCORTA_MAIL_WEBHOOK_SECRET=

# Empresa ficticia precargada: Moto Central Demo, con credenciales públicas.
# Solo se crea con SCORTA_TEST_COMPANY=1. Con NODE_ENV=production exige además
# SCORTA_TEST_COMPANY_PRODUCTION=1. Apagarla no borra una empresa existente ni reinicia sus cambios.
SCORTA_TEST_COMPANY=0
SCORTA_TEST_COMPANY_PRODUCTION=0

# Token (16+ caracteres) para ver el detalle de /healthz con Authorization: Bearer <token>.
# Sin él, /healthz solo dice ok/versión.
SCORTA_HEALTH_TOKEN=
